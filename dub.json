{
	"authors": [
		"cet"
	],
	"copyright": "Copyright © 2026, cet",
	"dependencies": {
		"requests": "~>2.2.1"
	},
	"description": "Browser automation with WebDriver lifecycle, element interaction, JavaScript execution, and multi-browser support.",
	"license": "Apache-2.0",
	"name": "selenium",
	"targetPath": "bin",
	"targetType": "library",
	"subPackages": [
		{
			"name": "webdriver",
			"dependencies": {
				"requests": "~>2.2.1"
			},
			"description": "WebDriver client: bridge, driver, browser capabilities, elements, and roots.",
			"sourcePaths": ["source/selenium"],
			"excludedSourceFiles": ["source/selenium/grid/**"],
			"targetType": "library",
			"targetPath": "bin",
			"configurations": [
				{
					"name": "library",
					"targetType": "library"
				},
				{
					"name": "unittest",
					"targetPath": "bin",
					"targetType": "executable",
					"sourcePaths": ["source/"],
					"excludedSourceFiles": ["source/selenium/grid/**", "source/tests/grid/**"],
					"preBuildCommands": [
						"$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests/webdriver"
					],
					"mainSourceFile": "bin/ut.d",
					"buildOptions": ["unittests"],
					"dependencies": {
						"requests": "~>2.2.1",
						"unit-threaded": "~>2.2.0"
					}
				}
			]
		},
		{
			"name": "grid",
			"dependencies": {
				"selenium:webdriver": "~>1.1"
			},
			"description": "Selenium Grid server scaffolding: hub, node, models, and routing.",
			"sourcePaths": ["source/selenium/grid"],
			"targetType": "library",
			"targetPath": "bin",
			"configurations": [
				{
					"name": "library",
					"targetType": "library"
				},
				{
					"name": "unittest",
					"targetPath": "bin",
					"targetType": "executable",
					"sourcePaths": ["source/"],
					"excludedSourceFiles": ["source/tests/webdriver/**"],
					"preBuildCommands": [
						"$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests/grid"
					],
					"mainSourceFile": "bin/ut.d",
					"buildOptions": ["unittests"],
					"dependencies": {
						"unit-threaded": "~>2.2.0"
					}
				}
			]
		}
	],
	"configurations": [
		{
			"name": "library",
			"targetType": "library",
			"targetPath": "bin",
			"excludedSourceFiles": ["source/tests/*"]
		},
		{
			"name": "unittest",
			"targetPath": "bin",
			"targetType": "executable",
			"preBuildCommands": [
				"$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests"
			],
			"mainSourceFile": "bin/ut.d",
			"buildOptions": ["unittests"],
			"dependencies": {
				"unit-threaded": "~>2.2.0"
			}
		}
	]
}