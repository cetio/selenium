{
	"authors": [
		"cet"
	],
	"copyright": "Copyright © 2026, cet",
	"dependencies": {
		"conductor": "~>2.1.0"
	},
	"description": "Modern Selenium SDK for D, inspired by Ruby's Selenium",
	"license": "AGPL-3.0",
	"name": "selenium-sdk",
	"targetType": "library",
	"configurations": [
		{
			"name": "library",
			"targetType": "library"
		},
		{
			"name": "unittest",
			"targetType": "executable",
			"preBuildCommands": [
				"$DUB run --compiler=$$DC unit-threaded -c gen_ut_main -- -f bin/ut.d"
			],
			"mainSourceFile": "bin/ut.d",
			"buildOptions": ["unittests"],
			"dependencies": {
				"unit-threaded": "~>2.2.0"
			}
		},
		{
			"name": "integration",
			"targetType": "executable",
			"preBuildCommands": [
				"$DUB run --compiler=$$DC unit-threaded -c gen_ut_main -- -f bin/ut.d"
			],
			"mainSourceFile": "bin/ut.d",
			"buildOptions": ["unittests"],
			"versions": ["integration"],
			"dependencies": {
				"unit-threaded": "~>2.2.0"
			}
		}
	]
}